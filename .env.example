# ─────────────────────────────────────────────────────────────────────────
# Example environment config.  Copy to `.env` for local use, or set these in
# your host's dashboard (Railway for the backend, Vercel for the frontend).
#
# ⚠️  GOLDEN RULE: anything prefixed VITE_ is PUBLIC — it gets baked into the
#     browser bundle and is readable by anyone.  NEVER put a real secret
#     (API key, token, DB password) in a VITE_ var.  Secrets live only in the
#     backend host's env (the variables WITHOUT the VITE_ prefix).
#     This parser API currently has no secrets — it's a stateless service.
# ─────────────────────────────────────────────────────────────────────────


# ── Backend (Railway) — server-side only ─────────────────────

# Port the API listens on.  Railway injects PORT automatically — leave unset there.
# PORT=5174

# Bind address.  0.0.0.0 in a container; 127.0.0.1 if only a local reverse proxy hits it.
HOST=0.0.0.0

# CORS allowlist — comma-separated origins, or * for any.
# Production: lock it to your site so other sites' browsers can't call the API.
CORS_ORIGIN=https://yourscript.app

# Per-IP rate limiting (the parser is expensive — this stops abuse).
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Where the bundled Java parser lives.  Defaults to ./backend in this repo.
# BACKEND_DIR=/app/backend

# Point at a live Line-Learner checkout instead of the bundled copy (parser dev only).
# LINE_LEARNER_PATH=/absolute/path/to/Line-Learner


# ── Frontend (Vercel) — PUBLIC, baked into the build ─────────

# The backend's public URL.  This is NOT a secret (it's a public endpoint).
# Leave empty for local dev (Vite proxies /api → :5174) or when using a
# same-origin Vercel rewrite.
VITE_API_BASE=https://api.yourscript.app
